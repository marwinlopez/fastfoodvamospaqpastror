{
  "expo": {
    "name": "Fast Food",
    "slug": "JL Fast Food",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/JLLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b1828"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1828"
      },
      "package": "com.marwinlopez.jlfastfood"
    },
    "androidStatusBar": {
      "backgroundColor": "#0b1828",
      "barStyle": "light-content",
      "hidden": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0b1828",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/JLLogo.png"
    },
    "plugins": []
  }
}
