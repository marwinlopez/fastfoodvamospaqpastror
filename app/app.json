{
  "expo": {
    "name": "Fast Food",
    "slug": "JL Fast Food",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/JLLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0b1828"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1828"
      },
      "package": "com.marwinlopez.jlfastfood",
      "permissions": ["android.permission.CAMERA"]
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app usa la cámara para escanear códigos de barra de productos."
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0b1828",
      "barStyle": "light-content",
      "hidden": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#0b1828",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/JLLogo.png"
    },
    "plugins": ["expo-barcode-scanner"]
  }
}
